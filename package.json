{
  "name": "slack-plane-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --no-errors-on-unmatched src tests",
    "lint:fix": "biome check --write --no-errors-on-unmatched src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^3.21.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^17.4.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
